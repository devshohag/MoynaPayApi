<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated by YoPay's own server, and the same file YoPay's suite checks against.
         It travels with the test binary so the pact is verified on every run. -->
    <None Include="fixtures\yopay-vectors.json" Link="fixtures/yopay-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Real bKash messages. The parser is replayed against every one on each run: a
         change that quietly stops recognising a wording is the failure this catches. -->
    <None Include="fixtures\bkash\corpus.tsv" Link="fixtures/bkash/corpus.tsv"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MoynaPay.Infrastructure\MoynaPay.Infrastructure.csproj" />
  </ItemGroup>
</Project>
